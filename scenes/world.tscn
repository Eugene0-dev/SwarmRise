[sub_resource type="GDScript" id="GDScript_e3hyu"]
script/source = "extends DirectionalLight2D

var time: float

func _ready() -> void:
	Global.tick.connect(_on_tick)
	energy = 0
	time = 0

func _on_tick() -> void:
	var day_progress: float = (Global.hour * 50.0) / Global.DAY_LENGTH
	var angle: float = (day_progress * TAU) - (PI / 2.0)
	energy = sin(angle)
"

